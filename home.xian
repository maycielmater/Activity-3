{{> head }}
<body class="bg-gray-50">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-center mt-10">Welcome to XianFire 🔥</h1>
    <p class="text-center mt-4">Home Page</p>
    <a href="/add">add new</a>
    </div>
    <table>
      <tr>
        <td>Name</td>
        <td>category</td>
        <td>brand</td>
        <td>flavor</td>
        <td>price</td>
        <td>cost</td>
        <td>action</td>
      </tr>
      <!-- dito po ang mga pogi -->
      {{#each data}}
      <tr>
        <td>{{Name}}</td>
        <td>{{category}}</td>
        <td>{{brand}}</td>
        <td>{{flavor}}</td>
        <td>{{price}}</td>
        <td>{{cost}}</td>
        <td><a href="/edit/{{id}}">edit</a>|delete</td>
      </tr>
      {{/each}}
      <!-- at natapos na -->
    </table>

    </div>
{{> footer }}